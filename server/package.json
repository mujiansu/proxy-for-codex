{
  "name": "proxy-for-codex-runtime",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Bundled MCP runtime for the Proxy for Codex plugin.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "esbuild server.mjs --bundle --platform=node --target=node22 --format=esm --outfile=server.bundle.mjs --legal-comments=eof --minify-whitespace && node normalize-bundle.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "esbuild": "0.25.12",
    "zod": "4.4.3"
  }
}
